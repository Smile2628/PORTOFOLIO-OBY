
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Ahmad Qurthuby | Personal Portfolio</title>

<style>
:root {
    --bg: #f5f7fb;
    --white: #ffffff;
    --navy: #101c35;
    --blue: #2563eb;
    --blue-light: #eaf1ff;
    --text: #1e293b;
    --muted: #64748b;
    --border: #e2e8f0;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.7;
}

/* NAVIGATION */
nav {
    width: 100%;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    background: rgba(255,255,255,.94);
    backdrop-filter: blur(15px);
    border-bottom: 1px solid var(--border);
}

.nav-container {
    max-width: 1150px;
    margin: auto;
    padding: 18px 25px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 23px;
    font-weight: 800;
    color: var(--navy);
    letter-spacing: -1px;
}

.logo span {
    color: var(--blue);
}

.nav-links {
    display: flex;
    gap: 30px;
}

.nav-links a {
    text-decoration: none;
    color: var(--muted);
    font-size: 14px;
    font-weight: 600;
    transition: .3s;
}

.nav-links a:hover {
    color: var(--blue);
}

/* HERO */
.hero {
    min-height: 100vh;
    padding: 150px 25px 90px;
    display: flex;
    align-items: center;
    background:
        radial-gradient(circle at 80% 30%, #dbeafe 0, transparent 30%),
        linear-gradient(135deg, #ffffff, #f1f5fb);
}

.hero-container {
    max-width: 1100px;
    width: 100%;
    margin: auto;
    display: grid;
    grid-template-columns: 1.3fr .7fr;
    align-items: center;
    gap: 60px;
}

.hero-label {
    color: var(--blue);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 18px;
}

.hero h1 {
    font-size: clamp(42px, 6vw, 68px);
    line-height: 1.15;
    color: var(--navy);
    letter-spacing: -2px;
    margin-bottom: 22px;
}

.hero h1 span {
    color: var(--blue);
}

.hero-description {
    max-width: 570px;
    color: var(--muted);
    font-size: 16px;
    margin-bottom: 30px;
}

.hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
}

.btn {
    display: inline-block;
    padding: 13px 24px;
    border-radius: 8px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    transition: .3s;
}

.btn-primary {
    background: var(--blue);
    color: white;
    box-shadow: 0 8px 20px #2563eb30;
}

.btn-primary:hover {
    background: #1d4ed8;
    transform: translateY(-3px);
}

.btn-secondary {
    color: var(--navy);
    border: 1px solid #cbd5e1;
    background: white;
}

.btn-secondary:hover {
    border-color: var(--blue);
    color: var(--blue);
    transform: translateY(-3px);
}

/* PROFILE */
.profile-area {
    display: flex;
    justify-content: center;
    align-items: center;
}

.profile-card {
    width: 290px;
    height: 350px;
    border-radius: 20px;
    background: linear-gradient(145deg, #172b50, #2563eb);
    box-shadow: 0 25px 60px #172b5030;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    overflow: hidden;
}

.profile-card::before {
    content: "";
    position: absolute;
    width: 250px;
    height: 250px;
    border: 1px solid #ffffff35;
    border-radius: 50%;
}

.profile-card::after {
    content: "";
    position: absolute;
    width: 190px;
    height: 190px;
    border: 1px solid #ffffff25;
    border-radius: 50%;
}

.profile-initial {
    color: white;
    font-size: 80px;
    font-weight: 800;
    letter-spacing: -5px;
    z-index: 2;
}

/* GENERAL SECTION */
section {
    padding: 95px 25px;
}

.container {
    max-width: 1100px;
    margin: auto;
}

.section-heading {
    text-align: center;
    margin-bottom: 50px;
}

.section-heading .eyebrow {
    color: var(--blue);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
}

.section-heading h2 {
    color: var(--navy);
    font-size: 36px;
    margin-top: 8px;
    letter-spacing: -1px;
}

.section-heading p {
    color: var(--muted);
    max-width: 600px;
    margin: 12px auto 0;
}

/* ABOUT */
.about-section {
    background: white;
}

.about-content {
    max-width: 850px;
    margin: auto;
    text-align: center;
}

.about-content p {
    color: var(--muted);
    font-size: 16px;
    line-height: 2;
}

/* SKILLS */
.skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
}

.skill-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 13px;
    padding: 30px;
    transition: .3s;
}

.skill-card:hover {
    transform: translateY(-7px);
    border-color: #93b4ff;
    box-shadow: 0 15px 35px #1e293b0c;
}

.skill-number {
    color: var(--blue);
    font-size: 14px;
    font-weight: 800;
    margin-bottom: 22px;
}

.skill-card h3 {
    color: var(--navy);
    font-size: 20px;
    margin-bottom: 12px;
}

.skill-card p {
    color: var(--muted);
    font-size: 14px;
}

/* CERTIFICATES */
.certificates-section {
    background: white;
}

.certificate-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
}

.certificate-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    transition: .3s;
    cursor: pointer;
}

.certificate-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 15px 35px #1e293b12;
    border-color: #93b4ff;
}

.certificate-image {
    height: 210px;
    background: #f1f5f9;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    padding: 12px;
}

.certificate-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: .3s;
}

.certificate-card:hover img {
    transform: scale(1.04);
}

.certificate-info {
    padding: 19px;
}

.certificate-info h3 {
    color: var(--navy);
    font-size: 16px;
    line-height: 1.5;
    margin-bottom: 6px;
}

.certificate-info p {
    color: var(--muted);
    font-size: 13px;
}

/* LIGHTBOX */
.lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(8, 15, 30, .94);
    justify-content: center;
    align-items: center;
    padding: 30px;
}

.lightbox.active {
    display: flex;
}

.lightbox img {
    max-width: 95%;
    max-height: 85vh;
    object-fit: contain;
    border-radius: 8px;
}

.lightbox-close {
    position: absolute;
    top: 18px;
    right: 30px;
    background: transparent;
    color: white;
    font-size: 40px;
    cursor: pointer;
}

/* CONTACT */
.contact-section {
    background: var(--navy);
    color: white;
    text-align: center;
}

.contact-section .section-heading h2 {
    color: white;
}

.contact-section .section-heading p {
    color: #cbd5e1;
}

.contact-description {
    max-width: 600px;
    margin: auto;
    color: #cbd5e1;
    text-align: center;
}

.contact-button {
    margin-top: 28px;
}

/* FOOTER */
footer {
    background: #0b1428;
    color: #94a3b8;
    text-align: center;
    padding: 25px;
    font-size: 13px;
}

/* ANIMATION */
.reveal {
    animation: appear .9s ease both;
}

@keyframes appear {
    from {
        opacity: 0;
        transform: translateY(25px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* RESPONSIVE */
@media(max-width: 800px) {
    .hero-container {
        grid-template-columns: 1fr;
        text-align: center;
        gap: 45px;
    }

    .hero-description {
        margin-left: auto;
        margin-right: auto;
    }

    .hero-buttons {
        justify-content: center;
    }

    .profile-card {
        width: 230px;
        height: 260px;
    }

    .profile-initial {
        font-size: 65px;
    }

    .skills-grid,
    .certificate-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media(max-width: 550px) {
    .nav-container {
        padding: 15px;
        flex-direction: column;
        gap: 12px;
    }

    .nav-links {
        gap: 15px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .nav-links a {
        font-size: 12px;
    }

    .hero {
        padding-top: 150px;
    }

    .hero h1 {
        font-size: 40px;
    }

    .section-heading h2 {
        font-size: 29px;
    }

    .skills-grid,
    .certificate-grid {
        grid-template-columns: 1fr;
    }

    section {
        padding: 75px 20px;
    }

    .certificate-image {
        height: 220px;
    }
}
</style>
</head>

