<script>
function bukaSertifikat(kartu) {
    const gambar = kartu.querySelector("img");

    document.getElementById("gambarBesar").src = gambar.src;
    document.getElementById("lightbox").classList.add("active");
}

function tutupSertifikat(event) {
    if (
        event.target.id === "lightbox" ||
        event.target.classList.contains("lightbox-close")
    ) {
        document.getElementById("lightbox").classList.remove("active");
        document.getElementById("gambarBesar").src = "";
    }
}

document.addEventListener("keydown", function(event) {
    if (event.key === "Escape") {
        document.getElementById("lightbox").classList.remove("active");
        document.getElementById("gambarBesar").src = "";
    }
});
</script>

